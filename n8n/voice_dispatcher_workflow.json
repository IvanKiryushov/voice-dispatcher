    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Ты — диспетчер и классификатор голосовых заметок. Сделай точную дословную транскрибацию аудио и определи категорию из списка: MEETINGS, CONTENT, WORK, INBOX. Верни СТРОГО валидный JSON без markdown-обёртки: { \\\"domain\\\": \\\"MEETINGS|CONTENT|WORK|INBOX\\\", \\\"sub_type\\\": \\\"...\\\", \\\"title\\\": \\\"...\\\", \\\"raw_transcript\\\": \\\"...\\\" }\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"audio/mp4\",\n            \"data\": \"{{ $binary.data.data }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "id": "f7f87045-368d-402b-8ccb-f48fdda6b903",
      "name": "Gemini Flash (STT + Classifier)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -1488,
        4096
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR_GEMINI_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Ты — диспетчер и классификатор голосовых заметок. Сделай точную дословную транскрибацию аудио и определи категорию из списка: MEETINGS, CONTENT, WORK, INBOX. Верни СТРОГО валидный JSON без markdown-обёртки: { \\\"domain\\\": \\\"MEETINGS|CONTENT|WORK|INBOX\\\", \\\"sub_type\\\": \\\"...\\\", \\\"title\\\": \\\"...\\\", \\\"raw_transcript\\\": \\\"...\\\" }\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"audio/mp4\",\n            \"data\": \"{{ $binary.data.data }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "id": "88aa1122-3344-5566-7788-9900aabbccdd",
      "name": "Gemini Fallback (STT + Classifier)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -1488,
        4300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const responseText = $input.item.json.candidates[0].content.parts[0].text;\nconst cleanedText = responseText.replace(/```json/g, '').replace(/```/g, '').trim();\nconst parsed = JSON.parse(cleanedText);\n\nconst triggerFile = $('Google Drive Trigger (Audio)').item.json;\nconst rawCreatedTime = triggerFile.createdTime || triggerFile.modifiedTime;\nconst fileDate = rawCreatedTime ? new Date(rawCreatedTime) : new Date();\n\nconst dateIso = fileDate.toISOString().split('T')[0];\nconst hours = String(fileDate.getHours()).padStart(2, '0');\nconst minutes = String(fileDate.getMinutes()).padStart(2, '0');\nconst seconds = String(fileDate.getSeconds()).padStart(2, '0');\nconst timeIso = `${hours}-${minutes}-${seconds}`;\nconst timestampFull = `${dateIso}_${timeIso}`;\n\nreturn {\n  domain: parsed.domain || 'INBOX',\n  sub_type: parsed.sub_type || 'Raw Note',\n  title: parsed.title || 'Voice Note',\n  raw_transcript: parsed.raw_transcript || '',\n  date_iso: dateIso,\n  time_iso: timeIso,\n  timestamp: timestampFull,\n  original_file_name: triggerFile.name || 'audio_note',\n  source_file_id: triggerFile.id\n};"
      },
      "id": "c4d08275-a0c9-4235-aa64-a75ccb0e4b4e",
      "name": "Parse Gemini JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        4096
      ]
    },
    {
      "parameters": {
        "operation": "createFromText",
        "content": "=---\ntitle: \"Raw Voice Note: {{ $json.timestamp }} — {{ $json.title }}\"\ncreated: {{ $json.date_iso }}\nupdated: {{ $json.date_iso }}\nsource: \"Voice Note via n8n\"\noriginal_file: \"{{ $json.original_file_name }}\"\noriginal_file_id: \"{{ $json.source_file_id }}\"\ncategory: \"{{ $json.domain }}\"\nsub_type: \"{{ $json.sub_type }}\"\nstatus: inbox\ntags:\n  - voice-note\n  - raw\n---\n\n# Сырая запись: {{ $json.original_file_name }}\n\n- **Время:** {{ $json.timestamp }}\n- **Категория:** {{ $json.domain }} ({{ $json.sub_type }})\n- **Заголовок:** {{ $json.title }}\n\n---\n\n## Полная расшифровка\n\n{{ $json.raw_transcript }}",
        "name": "={{ $json.timestamp }}_RAW_{{ $json.original_file_name }}.md",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "YOUR_OUTPUT_TRANSCRIPTS_FOLDER_ID",
          "mode": "id",
          "cachedResultName": "Transcripts",
          "cachedResultUrl": "https://drive.google.com/drive/folders/YOUR_OUTPUT_TRANSCRIPTS_FOLDER_ID"
        },
        "options": {}
      },
