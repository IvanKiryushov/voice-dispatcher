# === Пути к директориям ===
# Папка, куда попадают новые аудио/видео файлы (например, синхронизированная папка Google Drive / Яндекс.Диска)
INPUT_AUDIO_DIR=./data/input

# Папка, куда перемещаются исходные файлы после успешной расшифровки
PROCESSED_AUDIO_DIR=./data/processed

# Папка для сохранения готовых Markdown-заметок с расшифровками
OUTPUT_DIR=./data/output

# Опционально: папка для долгосрочного архива копий аудио по категориям (оставьте пустой, чтобы отключить)
ARCHIVE_AUDIO_DIR=

# === Настройки faster-whisper ===
# Модель: large-v3-turbo (рекомендуется для GPU), medium / small (для CPU)
WHISPER_MODEL=large-v3-turbo

# Устройство: cuda (видеокарта NVIDIA) или cpu
WHISPER_DEVICE=cuda

# Точность вычислений: int8 (GPU 4-6 GB VRAM и CPU) или float16 (GPU 8+ GB VRAM)
WHISPER_COMPUTE_TYPE=int8

# Код языка: ru, en и т.д. Оставьте пустым или укажите auto для автоопределения
WHISPER_LANGUAGE=ru

# Опционально: кастомный initial_prompt для модели (подсказка терминологии и пунктуации)
WHISPER_INITIAL_PROMPT=

# === Классификация заметок ===
# true — раскладывать по подпапкам категорий (MEETINGS, CONTENT, WORK, INBOX)
# false — сохранять все расшифровки в общую папку INBOX
ENABLE_CLASSIFICATION=true
